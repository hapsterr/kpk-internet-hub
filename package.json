{
  "name": "kpk-internet-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "postbuild": "node scripts/generate-sitemap.mjs && node scripts/verify-build.mjs",
    "dev": "react-router dev",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
